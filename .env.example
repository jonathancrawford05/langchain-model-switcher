# Example environment variables for LangChain Model Switcher
# Copy this file to .env and update with your actual values

# Model Provider Selection
# Options: claude, watson, ollama, openai
MODEL_PROVIDER=claude

# Anthropic Claude Configuration
CLAUDE_API_KEY=your_claude_api_key_here

# OpenAI Configuration (if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (if not using localhost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=llama3.1

# IBM Watson Configuration (if not using Skills Network)
WATSON_API_KEY=your_watson_api_key_here
WATSON_PROJECT_ID=your_watson_project_id
WATSON_URL=https://us-south.ml.cloud.ibm.com
WATSON_MODEL_ID=ibm/granite-3-2-8b-instruct

# MCP Server Configuration
MCP_HOST=localhost
MCP_PORT=8765

# Development Settings
PYTHONPATH=./src
